{
  "name": "@thyraa/cobol-to-scala",
  "version": "1.0.0",
  "description": "COBOL to Scala conversion engine",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./parser": "./parser/index.js",
    "./generator": "./generator/index.js"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "oracle": "node --test tests/oracle/oracle.test.js",
    "oracle:dialect": "ORACLE_DIALECT=${ORACLE_DIALECT:-ibm} ORACLE_SKIP_SCALA=1 node --test tests/oracle/oracle.test.js",
    "oracle:fuzz": "node tests/oracle/fuzz.js",
    "golden": "node --test tests/golden/golden.test.js",
    "golden:update": "node tests/golden/update.js"
  }
}
