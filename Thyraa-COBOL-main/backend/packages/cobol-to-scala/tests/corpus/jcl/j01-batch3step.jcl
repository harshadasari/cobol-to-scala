//* SAMPLE 3-STEP BATCH JOB WITH TEMP DATASET PASSING AND REFERBACK
//BATCH01  JOB (ACCT123,DEPT5),'J DOE',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1)
//* STEP 1: EXTRACT CUSTOMER MASTER INTO A TEMP WORK FILE
//STEP010  EXEC PGM=EXTRACT
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//INFILE   DD DSN=PROD.CUSTOMER.MASTER,DISP=SHR
//WORKOUT  DD DSN=&&WORK,DISP=(NEW,PASS),
//             UNIT=SYSDA,SPACE=(TRK,(5,5))
//STEP020  EXEC PGM=TRANSFRM
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//WORKIN   DD DSN=&&WORK,DISP=(OLD,DELETE)
//OUTFILE  DD DSN=PROD.CUSTOMER.STAGED,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(CYL,(10,5))
//STEP030  EXEC PGM=REPORT,COND=(4,LT)
//REPTIN   DD DSN=*.STEP020.OUTFILE,DISP=(OLD,KEEP)
//REPTOUT  DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
