       IDENTIFICATION DIVISION.
       PROGRAM-ID. R1309.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT FILE-A ASSIGN TO "R1309A.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-A.
           SELECT FILE-B ASSIGN TO "R1309B.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-B.
       DATA DIVISION.
       FILE SECTION.
       FD  FILE-A.
       01  REC-A               PIC X(10).
       FD  FILE-B.
       01  REC-B               PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-A                PIC X(2).
       01  FS-B                PIC X(2).
       01  WS-REENTRY-FLAG     PIC X(3) VALUE "NO".
       PROCEDURE DIVISION.
       DECLARATIVES.
       FILE-A-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON FILE-A.
       FILE-A-HANDLER-PARA.
           DISPLAY "HANDLER-A FIRED FS-A=" FS-A
               " REENTRY=" WS-REENTRY-FLAG.
       FILE-B-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON FILE-B.
       FILE-B-HANDLER-PARA.
           DISPLAY "HANDLER-B FIRED FS-B=" FS-B.
           MOVE "YES" TO WS-REENTRY-FLAG.
           OPEN INPUT FILE-A.
           DISPLAY "HANDLER-B AFTER NESTED OPEN A FS-A=" FS-A.
       END DECLARATIVES.
       MAIN-PARA.
           OPEN INPUT FILE-B.
           DISPLAY "AFTER OPEN B FS-B=" FS-B.
           STOP RUN.
