       IDENTIFICATION DIVISION.
       PROGRAM-ID. R1302M.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RESULT           PIC X(10) VALUE "UNSET".
       01  WS-COUNT            PIC 9(3)  VALUE 0.
       PROCEDURE DIVISION.
       MAIN-PARA.
           DISPLAY "BEFORE CALL RESULT=" WS-RESULT.
           CALL "R1302S" USING BY REFERENCE WS-RESULT, WS-COUNT.
           DISPLAY "AFTER CALL RESULT=" WS-RESULT " COUNT=" WS-COUNT.
           STOP RUN.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. R1302S.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SUB-FILE ASSIGN TO "R1302X.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-SUB.
       DATA DIVISION.
       FILE SECTION.
       FD  SUB-FILE.
       01  SUB-REC             PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-SUB              PIC X(2).
       LINKAGE SECTION.
       01  LK-RESULT           PIC X(10).
       01  LK-COUNT            PIC 9(3).
       PROCEDURE DIVISION USING LK-RESULT, LK-COUNT.
       DECLARATIVES.
       SUB-FILE-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON SUB-FILE.
       SUB-FILE-HANDLER-PARA.
           MOVE "HANDLED" TO LK-RESULT.
           ADD 1 TO LK-COUNT.
           DISPLAY "SUB HANDLER FIRED FS-SUB=" FS-SUB.
       END DECLARATIVES.
       SUB-MAIN.
           OPEN INPUT SUB-FILE.
           DISPLAY "SUB AFTER OPEN FS-SUB=" FS-SUB.
           ADD 1 TO LK-COUNT.
           GOBACK.
       END PROGRAM R1302S.
       END PROGRAM R1302M.
