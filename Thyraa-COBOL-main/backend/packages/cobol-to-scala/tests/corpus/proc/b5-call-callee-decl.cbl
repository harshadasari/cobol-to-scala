       IDENTIFICATION DIVISION.
       PROGRAM-ID. MAINPROG.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RESULT PIC 9(4) VALUE 0.
       PROCEDURE DIVISION.
       MAIN-PARA.
           DISPLAY "CALLER BEFORE".
           CALL "SUBDECL" USING BY REFERENCE WS-RESULT.
           DISPLAY "CALLER AFTER RESULT=" WS-RESULT.
           STOP RUN.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. SUBDECL.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SUB-FILE ASSIGN TO "NOSUCHSUB.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-SUBSTATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  SUB-FILE.
       01  SUB-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  WS-SUBSTATUS PIC XX.
       LINKAGE SECTION.
       01  LK-RESULT PIC 9(4).
       PROCEDURE DIVISION USING LK-RESULT.
       DECLARATIVES.
       SUB-ERR-SECTION SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON SUB-FILE.
       SUB-ERR-PARA.
           DISPLAY "SUB HANDLER FIRED STATUS=" WS-SUBSTATUS.
           MOVE 99 TO LK-RESULT.
       END DECLARATIVES.
       SUB-MAIN SECTION.
       SUB-MAIN-PARA.
           OPEN INPUT SUB-FILE.
           DISPLAY "SUB AFTER OPEN STATUS=" WS-SUBSTATUS.
           GOBACK.
       END PROGRAM SUBDECL.
       END PROGRAM MAINPROG.
