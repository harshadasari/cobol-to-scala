       IDENTIFICATION DIVISION.
       PROGRAM-ID. D01M.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT OUT-FILE ASSIGN TO "D01OUT.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT BAD-FILE ASSIGN TO "D01NOSUCH.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-BAD.
       DATA DIVISION.
       FILE SECTION.
       FD  OUT-FILE.
       01  OUT-REC PIC X(10).
       FD  BAD-FILE.
       01  BAD-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-BAD PIC XX.
       01  WS-LINE PIC X(10).
       01  WS-RESULT PIC 9(4) VALUE 0.
       PROCEDURE DIVISION.
       DECLARATIVES.
       BAD-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON BAD-FILE.
       BAD-HANDLER-PARA.
           DISPLAY "MAIN HANDLER FIRED FS=" FS-BAD.
       END DECLARATIVES.
       MAIN-SECTION SECTION.
       MAIN-PARA.
           OPEN OUTPUT OUT-FILE.
           MOVE "ROWONE" TO OUT-REC.
           WRITE OUT-REC.
           MOVE "ROWTWO" TO OUT-REC.
           WRITE OUT-REC.
           CLOSE OUT-FILE.

           OPEN INPUT OUT-FILE.
           READ OUT-FILE INTO WS-LINE
               AT END DISPLAY "UNEXPECTED EOF"
           END-READ.
           DISPLAY "READ1=" WS-LINE.
           READ OUT-FILE INTO WS-LINE
               AT END DISPLAY "UNEXPECTED EOF"
           END-READ.
           DISPLAY "READ2=" WS-LINE.
           CLOSE OUT-FILE.

           OPEN INPUT BAD-FILE.
           DISPLAY "AFTER BAD OPEN FS=" FS-BAD.

           CALL "D01S" USING BY REFERENCE WS-RESULT.
           DISPLAY "AFTER CALL RESULT=" WS-RESULT.
           STOP RUN.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. D01S.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SUB-OUT ASSIGN TO "D01SUBOUT.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT SUB-BAD ASSIGN TO "D01SUBNOSUCH.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-SUBBAD.
       DATA DIVISION.
       FILE SECTION.
       FD  SUB-OUT.
       01  SUB-OUT-REC PIC X(10).
       FD  SUB-BAD.
       01  SUB-BAD-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-SUBBAD PIC XX.
       LINKAGE SECTION.
       01  LK-RESULT PIC 9(4).
       PROCEDURE DIVISION USING LK-RESULT.
       DECLARATIVES.
       SUB-BAD-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON SUB-BAD.
       SUB-BAD-HANDLER-PARA.
           DISPLAY "SUB HANDLER FIRED FS=" FS-SUBBAD.
           MOVE 42 TO LK-RESULT.
       END DECLARATIVES.
       SUB-MAIN SECTION.
       SUB-MAIN-PARA.
           OPEN OUTPUT SUB-OUT.
           MOVE "SUBROW" TO SUB-OUT-REC.
           WRITE SUB-OUT-REC.
           CLOSE SUB-OUT.
           OPEN INPUT SUB-BAD.
           DISPLAY "SUB AFTER BAD OPEN FS=" FS-SUBBAD.
           GOBACK.
       END PROGRAM D01S.
       END PROGRAM D01M.
