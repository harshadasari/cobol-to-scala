       IDENTIFICATION DIVISION.
       PROGRAM-ID. E07A.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT A-BAD ASSIGN TO "E07ANOSUCH.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-A.
       DATA DIVISION.
       FILE SECTION.
       FD  A-BAD.
       01  A-BAD-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-A PIC XX.
       01  WS-RESULT PIC 9(4) VALUE 0.
       PROCEDURE DIVISION.
       DECLARATIVES.
       A-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON A-BAD.
       A-HANDLER-PARA.
           DISPLAY "A HANDLER FIRED FS=" FS-A.
       END DECLARATIVES.
       A-MAIN SECTION.
       A-MAIN-PARA.
           OPEN INPUT A-BAD.
           DISPLAY "A AFTER OPEN FS=" FS-A.
           CALL "E07B" USING BY REFERENCE WS-RESULT.
           DISPLAY "A AFTER CALL RESULT=" WS-RESULT.
           STOP RUN.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. E07B.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT B-BAD ASSIGN TO "E07BNOSUCH.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-B.
       DATA DIVISION.
       FILE SECTION.
       FD  B-BAD.
       01  B-BAD-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-B PIC XX.
       01  WS-SUBRESULT PIC 9(4) VALUE 0.
       LINKAGE SECTION.
       01  LK-RESULT PIC 9(4).
       PROCEDURE DIVISION USING LK-RESULT.
       DECLARATIVES.
       B-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON B-BAD.
       B-HANDLER-PARA.
           DISPLAY "B HANDLER FIRED FS=" FS-B.
           MOVE 7 TO LK-RESULT.
       END DECLARATIVES.
       B-MAIN SECTION.
       B-MAIN-PARA.
           OPEN INPUT B-BAD.
           DISPLAY "B AFTER OPEN FS=" FS-B.
           CALL "E07C" USING BY REFERENCE WS-SUBRESULT.
           DISPLAY "B AFTER CALL SUBRESULT=" WS-SUBRESULT.
           ADD WS-SUBRESULT TO LK-RESULT.
           GOBACK.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. E07C.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT C-BAD ASSIGN TO "E07CNOSUCH.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS FS-C.
       DATA DIVISION.
       FILE SECTION.
       FD  C-BAD.
       01  C-BAD-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01  FS-C PIC XX.
       LINKAGE SECTION.
       01  LK-CRESULT PIC 9(4).
       PROCEDURE DIVISION USING LK-CRESULT.
       DECLARATIVES.
       C-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON C-BAD.
       C-HANDLER-PARA.
           DISPLAY "C HANDLER FIRED FS=" FS-C.
           MOVE 100 TO LK-CRESULT.
       END DECLARATIVES.
       C-MAIN SECTION.
       C-MAIN-PARA.
           OPEN INPUT C-BAD.
           DISPLAY "C AFTER OPEN FS=" FS-C.
           GOBACK.
       END PROGRAM E07C.
       END PROGRAM E07B.
       END PROGRAM E07A.
