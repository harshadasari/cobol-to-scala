       IDENTIFICATION DIVISION.
       PROGRAM-ID. G07MAIN.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT WS-BADFILE ASSIGN TO "/no/such/dir/G07BAD.DAT"
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD  WS-BADFILE.
       01  WS-BADREC PIC X(20).
       WORKING-STORAGE SECTION.
       01  WS-STATUS PIC XX.
       PROCEDURE DIVISION.
       DECLARATIVES.
       BAD-HANDLER SECTION.
           USE AFTER STANDARD ERROR PROCEDURE ON WS-BADFILE.
       BAD-PARA.
           DISPLAY "DECL-HANDLER-FIRED".
           DISPLAY "DECL-STATUS=" WS-STATUS.
       END DECLARATIVES.
       MAIN-SECTION SECTION.
       MAIN-PARA.
           DISPLAY "BEFORE-CALL".
           CALL "G07SORT".
           DISPLAY "AFTER-CALL".
           OPEN OUTPUT WS-BADFILE.
           DISPLAY "AFTER-OPEN".
           STOP RUN.
       END PROGRAM G07MAIN.

       IDENTIFICATION DIVISION.
       PROGRAM-ID. G07SORT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT SD-FILE ASSIGN TO "G07SORTWORK".
       DATA DIVISION.
       FILE SECTION.
       SD  SD-FILE.
       01  SD-REC.
           05  SD-KEY  PIC 9(3).
           05  SD-VAL  PIC X(5).
       WORKING-STORAGE SECTION.
       01  WS-EOF PIC X VALUE "N".
       01  WS-IDX PIC 9(2) VALUE 0.
       01  WS-SRC-TABLE.
           05  FILLER PIC X(8) VALUE "030VVVVV".
           05  FILLER PIC X(8) VALUE "010WWWWW".
           05  FILLER PIC X(8) VALUE "020XXXXX".
       01  WS-SRC-ARR REDEFINES WS-SRC-TABLE OCCURS 3 TIMES.
           05  A-KEY PIC 9(3).
           05  A-VAL PIC X(5).
       PROCEDURE DIVISION.
       SUB-PARA.
           SORT SD-FILE ASCENDING KEY SD-KEY
               INPUT PROCEDURE IS FEED-PARA
               OUTPUT PROCEDURE IS EMIT-PARA.
           GOBACK.
       FEED-PARA.
           PERFORM VARYING WS-IDX FROM 1 BY 1 UNTIL WS-IDX > 3
               MOVE A-KEY(WS-IDX) TO SD-KEY
               MOVE A-VAL(WS-IDX) TO SD-VAL
               RELEASE SD-REC
           END-PERFORM.
       EMIT-PARA.
           PERFORM UNTIL WS-EOF = "Y"
               RETURN SD-FILE AT END MOVE "Y" TO WS-EOF
               NOT AT END DISPLAY "SORTED=" SD-KEY " " SD-VAL
           END-PERFORM.
       END PROGRAM G07SORT.
