# Dependencies - never read these
node_modules/
.npm/
.yarn/
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
*.min.js
*.min.css
*.map

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Test coverage
coverage/
.nyc_output/
*.lcov

# Large data files
*.csv
*.json.gz
*.db
*.sqlite
*.sql
data/
fixtures/

# Generated files
*.generated.*
*-generated.*
.auto/

# Binary files
*.exe
*.dll
*.so
*.dylib
*.wasm
*.bin

# Media files (usually not needed for code work)
*.mp4
*.mov
*.avi
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot

# Environment files (security)
.env
.env.*
*.pem
*.key
*.cert
secrets/

# Git internals
.git/
.gitignore

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
ENV/

# Java
target/
*.class
*.jar
*.war

# Ruby
vendor/bundle/
.bundle/

# Go
vendor/
