# ============================================================================
# CLAUDE CODE WORKSPACE CONFIGURATION
# ============================================================================
# Copy this to your project root and customize per project
# Load with: source workspace.env (or export statements in your workflow)
# ============================================================================

# ============================================================================
# MODEL SELECTION DEFAULTS
# ============================================================================
# Choose default model for different operation types
# Options: haiku | sonnet | opus

# Default model for general operations
CLAUDE_DEFAULT_MODEL=haiku

# Model for file operations (read, write, search)
CLAUDE_FILE_OPS_MODEL=haiku

# Model for code generation
CLAUDE_CODE_GEN_MODEL=haiku

# Model for debugging/analysis
CLAUDE_DEBUG_MODEL=sonnet

# Model for architecture/design decisions
CLAUDE_DESIGN_MODEL=opus

# Model for testing operations
CLAUDE_TEST_MODEL=haiku

# Model for documentation
CLAUDE_DOCS_MODEL=haiku

# ============================================================================
# COST OPTIMIZATION CONTROLS
# ============================================================================

# Automatically use Grep before Read for searches (true/false)
CLAUDE_GREP_FIRST=true

# Prefer Glob over bash find commands (true/false)
CLAUDE_USE_GLOB=true

# Batch similar file operations together (true/false)
CLAUDE_BATCH_FILES=true

# Maximum files to read in a single request (prevents expensive multi-file reads)
CLAUDE_MAX_FILES_PER_REQUEST=5

# Maximum file size to read (in KB, 0=unlimited)
CLAUDE_MAX_FILE_SIZE_KB=500

# Use line-specific reads when possible (true/false)
CLAUDE_PREFER_LINE_READS=true

# ============================================================================
# OUTPUT CONTROLS
# ============================================================================

# Response style: concise | balanced | detailed
CLAUDE_RESPONSE_STYLE=concise

# Include code insights in responses (true/false)
CLAUDE_SHOW_INSIGHTS=true

# Show file references instead of full code blocks when possible (true/false)
CLAUDE_USE_REFERENCES=true

# Limit output tokens for simple operations (0=unlimited)
CLAUDE_SIMPLE_OPS_MAX_TOKENS=2000

# Limit output tokens for complex operations (0=unlimited)
CLAUDE_COMPLEX_OPS_MAX_TOKENS=8000

# ============================================================================
# CONTEXT MANAGEMENT
# ============================================================================

# Aggressively use prompt caching (true/false)
CLAUDE_CACHE_AGGRESSIVE=true

# Auto-clear context after N minutes of inactivity (0=never)
CLAUDE_AUTO_CLEAR_MINS=30

# Warn when context window is getting large (true/false)
CLAUDE_WARN_LARGE_CONTEXT=true

# Context warning threshold (in tokens)
CLAUDE_CONTEXT_WARN_THRESHOLD=50000

# ============================================================================
# SEARCH & DISCOVERY
# ============================================================================

# Use Task/Explore agent for complex searches (true/false)
CLAUDE_USE_EXPLORE_AGENT=true

# Explore agent default thoroughness: quick | medium | very-thorough
CLAUDE_EXPLORE_THOROUGHNESS=medium

# Grep output limit (number of matches to return)
CLAUDE_GREP_LIMIT=50

# Glob pattern result limit
CLAUDE_GLOB_LIMIT=100

# ============================================================================
# FILE FILTERING (like .claudeignore)
# ============================================================================

# Skip node_modules automatically (true/false)
CLAUDE_SKIP_NODE_MODULES=true

# Skip build directories (dist, build, out, etc.) (true/false)
CLAUDE_SKIP_BUILD_DIRS=true

# Skip generated files (*.generated.*, *-generated.*, etc.) (true/false)
CLAUDE_SKIP_GENERATED=true

# Skip binary files automatically (true/false)
CLAUDE_SKIP_BINARIES=true

# Skip large media files (true/false)
CLAUDE_SKIP_MEDIA=true

# Skip log files (true/false)
CLAUDE_SKIP_LOGS=true

# Additional patterns to ignore (comma-separated glob patterns)
CLAUDE_IGNORE_PATTERNS="*.min.js,*.map,coverage/*,*.lock"

# ============================================================================
# INTELLIGENT ROUTING
# ============================================================================

# Auto-select model based on task complexity (true/false)
CLAUDE_AUTO_SELECT_MODEL=true

# Keywords that trigger Opus usage (comma-separated)
CLAUDE_OPUS_KEYWORDS="design,architect,optimize,performance,security,debug complex,analyze"

# Keywords that force Haiku usage (comma-separated)
CLAUDE_HAIKU_KEYWORDS="format,lint,test,run,read,list,find,search"

# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Parallel tool execution where possible (true/false)
CLAUDE_PARALLEL_TOOLS=true

# Maximum parallel operations
CLAUDE_MAX_PARALLEL=3

# Request timeout in seconds (0=no timeout)
CLAUDE_REQUEST_TIMEOUT=120

# ============================================================================
# DEVELOPER EXPERIENCE
# ============================================================================

# Show cost estimate before expensive operations (true/false)
CLAUDE_SHOW_COST_ESTIMATE=false

# Show token usage in responses (true/false)
CLAUDE_SHOW_TOKEN_USAGE=false

# Confirm before Opus usage (true/false)
CLAUDE_CONFIRM_OPUS=false

# Verbose logging (true/false)
CLAUDE_VERBOSE=false

# ============================================================================
# PROJECT-SPECIFIC SETTINGS
# ============================================================================

# Project type: backend | frontend | fullstack | mobile | data
PROJECT_TYPE=fullstack

# Primary language: typescript | javascript | python | java | scala | go
PROJECT_LANGUAGE=typescript

# Framework: react | vue | angular | nextjs | express | django | spring
PROJECT_FRAMEWORK=react

# Test framework: jest | mocha | pytest | junit
TEST_FRAMEWORK=jest

# ============================================================================
# WORKFLOW AUTOMATION
# ============================================================================

# Auto-run tests after code changes (true/false)
CLAUDE_AUTO_TEST=false

# Auto-format code after generation (true/false)
CLAUDE_AUTO_FORMAT=true

# Auto-lint after code generation (true/false)
CLAUDE_AUTO_LINT=true

# Generate commit message suggestions (true/false)
CLAUDE_SUGGEST_COMMITS=false

# ============================================================================
# QUALITY CONTROLS
# ============================================================================

# Require type safety in generated code (true/false)
CLAUDE_ENFORCE_TYPES=true

# Include error handling by default (true/false)
CLAUDE_INCLUDE_ERROR_HANDLING=true

# Generate tests with implementation (true/false)
CLAUDE_GENERATE_TESTS=false

# Include documentation comments (true/false)
CLAUDE_INCLUDE_DOCS=true

# Code style: minimal | balanced | comprehensive
CLAUDE_CODE_STYLE=balanced

# ============================================================================
# CUSTOM ALIASES (for shell integration)
# ============================================================================

# Define custom shortcuts for common operations
ALIAS_QUICK_FIX="claude --model haiku 'Fix syntax and lint errors'"
ALIAS_QUICK_TEST="claude --model haiku 'Run all tests and report failures'"
ALIAS_QUICK_FMT="claude --model haiku 'Format all code files'"
ALIAS_PLAN="claude --model opus 'Create implementation plan for'"
ALIAS_REVIEW="claude --model sonnet 'Review code for issues in'"
ALIAS_OPTIMIZE="claude --model opus 'Optimize performance of'"

# ============================================================================
# MONITORING & ANALYTICS
# ============================================================================

# Track cost per session (true/false)
CLAUDE_TRACK_COSTS=true

# Log all requests for analysis (true/false)
CLAUDE_LOG_REQUESTS=false

# Request log file path
CLAUDE_LOG_PATH=".claude/requests.log"

# Generate weekly efficiency report (true/false)
CLAUDE_WEEKLY_REPORT=false

# ============================================================================
# ADVANCED FEATURES
# ============================================================================

# Use streaming responses for long outputs (true/false)
CLAUDE_STREAM_RESPONSES=true

# Enable experimental features (true/false)
CLAUDE_EXPERIMENTAL=false

# Custom API endpoint (leave empty for default)
CLAUDE_API_ENDPOINT=""

# API key source: env | file | keychain
CLAUDE_API_KEY_SOURCE=env

# ============================================================================
# PRESETS
# ============================================================================
# Quickly switch between different configurations
# Uncomment one preset or create your own

# PRESET: Ultra Efficient (minimize costs)
# CLAUDE_DEFAULT_MODEL=haiku
# CLAUDE_RESPONSE_STYLE=concise
# CLAUDE_MAX_FILES_PER_REQUEST=3
# CLAUDE_AUTO_SELECT_MODEL=true

# PRESET: Balanced (good mix of speed and quality)
# CLAUDE_DEFAULT_MODEL=haiku
# CLAUDE_DEBUG_MODEL=sonnet
# CLAUDE_DESIGN_MODEL=opus
# CLAUDE_RESPONSE_STYLE=balanced

# PRESET: Quality First (best results, higher cost)
# CLAUDE_DEFAULT_MODEL=sonnet
# CLAUDE_CODE_GEN_MODEL=sonnet
# CLAUDE_DEBUG_MODEL=opus
# CLAUDE_RESPONSE_STYLE=detailed

# PRESET: Speed Mode (fastest responses)
# CLAUDE_DEFAULT_MODEL=haiku
# CLAUDE_RESPONSE_STYLE=concise
# CLAUDE_PARALLEL_TOOLS=true
# CLAUDE_MAX_PARALLEL=5

# ============================================================================
# NOTES
# ============================================================================
#
# LOADING THIS CONFIG:
# --------------------
# Option 1: Source in terminal
#   $ source workspace.env
#
# Option 2: Add to .zshrc/.bashrc
#   export $(cat /path/to/workspace.env | grep -v '^#' | xargs)
#
# Option 3: Use with direnv
#   $ echo "dotenv" > .envrc
#   $ direnv allow
#
# VIEWING CURRENT SETTINGS:
# -------------------------
#   $ env | grep CLAUDE_
#
# QUICK MODEL OVERRIDE:
# ---------------------
#   $ CLAUDE_DEFAULT_MODEL=opus claude "your prompt"
#
# COST TRACKING:
# --------------
#   $ claude /cost
#
# ============================================================================
